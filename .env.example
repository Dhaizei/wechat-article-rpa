# 微信公众号 RPA 本机配置模板
# 复制为 .env 后填写；.env 已被 Git 忽略，不会提交 API Key。

# Qwen-VL：本地 OCR 多次失败后才调用。API Key 不能为空。
QWEN_VL_BASE_URL=http://192.168.33.27/v1
QWEN_VL_API_KEY=
QWEN_VL_MODEL=dashscope/qwen3-vl-plus

# MongoDB
MONGO_URI=mongodb://192.168.28.70:27019/
MONGO_DATABASE=weixin
MONGO_ARTICLE_COLLECTION=article
MONGO_TARGET_COLLECTION=collection_target

# 控制台（开放局域网访问前务必修改密码）
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=admin-123

# 可选：控制台展示层使用的集合名
ARTICLE_MONGO_DATABASE=weixin
ARTICLE_MONGO_COLLECTION=article
DAILY_REPORT_MONGO_COLLECTION=daily_reports
