# MongoDB：默认示例使用本机实例，请按实际环境修改。
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=weixin
MONGO_ACCOUNT_COLLECTION=collection_target
MONGO_ARTICLE_COLLECTION=article

# 管理控制台：必须自行设置强密码，不要直接使用示例值。
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=请替换为至少16位的随机密码

# Qwen-VL 仅在本地 OCR 多次失败时作为可选兜底。
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus

# 控制台监听地址；只在可信局域网中使用 0.0.0.0。
RPA_CONTROL_HOST=127.0.0.1
RPA_CONTROL_PORT=8010
